<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Overlingo.App</RootNamespace>
    <AssemblyName>Overlingo</AssemblyName>
    <ApplicationIcon>Assets\overlingo.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);SYSLIB1054;CA1416;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Overlingo.Core\Overlingo.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\overlingo.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets\sample-placement.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Languages\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\testimages\*.*" Link="testimages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
