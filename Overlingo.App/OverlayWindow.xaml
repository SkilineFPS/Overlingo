<Window x:Class="Overlingo.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlingo – overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Width="1000" Height="200" Focusable="False">
    <Grid>
        <Border x:Name="Box" CornerRadius="10" Padding="16,8" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#8C000000" BorderThickness="0" Visibility="Collapsed">
            <StackPanel x:Name="Lines"/>
        </Border>
        <Border x:Name="EditFrame" BorderBrush="#FFFFC107" BorderThickness="3" CornerRadius="10" Visibility="Collapsed" Background="#55FFC107">
            <TextBlock x:Name="EditHint" Foreground="#FFFFC107" FontSize="18" FontWeight="Bold" TextAlignment="Center"
                       VerticalAlignment="Top" Margin="8" TextWrapping="Wrap"
                       Text="REŽIM ÚPRAV – chyťte kdekoli myší a přetáhněte. Velikost měňte tažením žlutého čtverce vpravo dole. Ukončení: tlačítko v záložce Overlay."/>
        </Border>
        <Thumb x:Name="Grip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Width="28" Height="28" Cursor="SizeNWSE" Background="#FFFFC107" DragDelta="OnGripDrag"/>
    </Grid>
</Window>
