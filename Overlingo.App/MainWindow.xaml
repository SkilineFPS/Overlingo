<Window x:Class="Overlingo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlingo" Icon="Assets/overlingo.ico" Width="1120" Height="800" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" Padding="20,10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <CheckBox x:Name="CbAdvancedUi" DockPanel.Dock="Left" Margin="0,0,18,0" VerticalAlignment="Center" Content="Zobrazit pokročilá nastavení" Click="OnAdvancedUiToggled"/>
                <Button x:Name="BtnSave" Content="Uložit a použít nastavení" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource AccentButton}" Click="OnSave"/>
                <TextBlock x:Name="StatusBar" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Připraveno."/>
            </DockPanel>
        </Border>
        <Grid>
            <TabControl x:Name="Tabs">
<TabItem x:Name="TabHome" Header="🏠  Přehled">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="940" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Přehled"/>
                    <Border Style="{StaticResource HeroCard}" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StateDot" Width="12" Height="12" Fill="{StaticResource Muted}" Margin="0,2,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TileState" Text="Zastaveno" FontSize="26" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="TileSub" Foreground="{StaticResource Muted}" Margin="22,4,12,0" TextWrapping="Wrap" Text="Stiskněte Spustit překlad."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnPause" Content="Pauza OCR (F10)" Click="OnPauseOcr" Margin="0,0,10,0" Padding="16,12"/>
                                <Button x:Name="BtnToggle" Content="▶  Spustit překlad (F8)" Click="OnToggleTranslation" Style="{StaticResource AccentButton}" Margin="0" Padding="28,14" FontSize="15"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="DashWarn" Foreground="{StaticResource Bad}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Border Style="{StaticResource Card}" Padding="22" Background="#22EC4899" BorderBrush="#66EC4899">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H2}" Margin="0,0,0,4" Text="❤  Líbí se vám Overlingo?"/>
                                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Overlingo je zdarma a zdarma zůstane, nic se nezamyká. Pokud vám šetří čas při hraní, můžete vývoj dobrovolně podpořit libovolnou částkou přes PayPal. Děkuji!"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                                <Button Content="❤  Podpořit přes PayPal" Style="{StaticResource SupportButton}" Padding="22,12" FontSize="14" Margin="0" Click="OnSupport"/>
                                <Button Content="Kopírovat odkaz" Margin="0,8,0,0" Click="OnCopySupportLink"/>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Co se překládá (přepnutí také zkratkou, výchozí F7)"/>
                    </StackPanel>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <RadioButton x:Name="RbScopeDialog" GroupName="scope" Style="{StaticResource CardRadio}" Checked="OnScopeChanged">
                            <StackPanel>
                                <TextBlock Text="💬  Jen konverzace" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Titulky dole uprostřed obrazovky (oblast z Výběru oblasti). Překlad se zobrazí těsně nad originálem. Nejlehčí na CPU."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbScopeFull" GroupName="scope" Style="{StaticResource CardRadio}" Margin="0" Checked="OnScopeChanged">
                            <StackPanel>
                                <TextBlock Text="🖥  Vše na obrazovce" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Každý anglický text se přeloží a zobrazí přímo přes původní. Dražší na CPU, interval nejméně 0,7 s."/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Odkud se čte obraz"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20,14">
                        <StackPanel>
                            <RadioButton x:Name="RbWindow" GroupName="src" Content="Zachytávání okna – vyberete konkrétní okno ze seznamu" Margin="0,2" Checked="OnSourceKindChanged"/>
                            <Grid Margin="22,2,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CbWindow" IsEditable="True" DisplayMemberPath="Label"/>
                                <Button Grid.Column="1" Content="Obnovit seznam" Margin="8,0,0,0" Click="OnRefreshSources"/>
                            </Grid>
                            <TextBlock x:Name="WindowFound" Margin="22,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                            <RadioButton x:Name="RbProgram" GroupName="src" Content="Zachytávání programu – podle názvu procesu, po restartu hry se připojí znovu" Margin="0,2" Checked="OnSourceKindChanged"/>
                            <ComboBox x:Name="CbProgram" IsEditable="True" Margin="22,2,0,8" Width="360" HorizontalAlignment="Left"/>
                            <RadioButton x:Name="RbMonitor" GroupName="src" Content="Zachytávání celé obrazovky" Margin="0,2" Checked="OnSourceKindChanged"/>
                            <ComboBox x:Name="CbMonitor" Margin="22,2,0,8" Width="360" HorizontalAlignment="Left"/>
                            <RadioButton x:Name="RbElgato" GroupName="src" Content="Zachytávání ze záznamové karty" Margin="0,2" Checked="OnSourceKindChanged"/>
                            <Grid Margin="22,2,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CbCapture"/>
                                <Button Grid.Column="1" Content="Najít karty" Margin="8,0,0,0" Click="OnRefreshCards"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Oblast titulků"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,2" Text="Platí pro režim „Jen konverzace“; „Vše na obrazovce“ čte celý obraz."/>
                            <TextBlock x:Name="RegionText" Margin="0,4" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource AccentButton}" Content="🖱  Graficky nastavit čtení i umístění překladu…" Click="OnPlacementEditor" HorizontalAlignment="Left" Margin="0,4"/>
                            <WrapPanel Margin="0,4">
                                <Button Content="Vybrat oblast myší (F11)" Click="OnSelectRegion"/>
                                <Button Content="Výchozí spodní pás" Click="OnRegionDefault"/>
                                <Button Content="Celý obraz" Click="OnRegionFull"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Oblast se ukládá jako zlomek obrazu, takže platí pro libovolné rozlišení. Můžete ji měnit kdykoli, i za běhu překladu."/>
                            <Border x:Name="AdvSource" Style="{StaticResource AdvPanel}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AdvTag}" Text="POKROČILÉ"/>
                                    <CheckBox x:Name="CbGameArea" Content="Počítat oblast uvnitř obrazu hry (automaticky ořízne černé pruhy kolem obrazu)" Margin="0,4"/>
                                    <CheckBox x:Name="CbIgnoreSide" Content="Překládat jen blok dialogu (ignorovat úkoly mise a nápovědy pod nebo nad titulky)" Margin="0,4" ToolTip="Ignorovat řádky mimo dialog (úkoly mise, nápovědy pod nebo nad titulky) – překládá se jen blok dialogu"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Výkon"/>
                    </StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,6">
                        <RadioButton x:Name="RbPerfEco" GroupName="perf" Style="{StaticResource CardRadio}" Checked="OnPerfChanged">
                            <StackPanel>
                                <TextBlock Text="🍃  Šetrný" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Nejnižší zátěž CPU. Pro slabší počítače."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbPerfBalanced" GroupName="perf" Style="{StaticResource CardRadio}" Checked="OnPerfChanged">
                            <StackPanel>
                                <TextBlock Text="⚖  Vyvážený" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Doporučeno. Dobrá rychlost i zátěž."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbPerfFast" GroupName="perf" Style="{StaticResource CardRadio}" Margin="0" Checked="OnPerfChanged">
                            <StackPanel>
                                <TextBlock Text="⚡  Rychlý" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Nejmenší prodleva, vyšší zátěž CPU."/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <TextBlock x:Name="PerfNote" Style="{StaticResource Hint}" Margin="2,0,0,14"/>

                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Stav"/>
                            <TextBlock x:Name="ChkOcr" Margin="0,3"/>
                            <TextBlock x:Name="ChkSource" Margin="0,3"/>
                            <TextBlock x:Name="ChkTranslator" Margin="0,3"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Nejjednodušší cesta: spusťte průvodce, vyberte hru, jazyky a překladač, označte titulky a stiskněte Spustit překlad."/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource AccentButton}" Content="🚀  Spustit průvodce nastavením" Click="OnRunWizard"/>
                                <Button Content="🎯  Vybrat oblast titulků (F11)" Click="OnSelectRegion"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Poslední titulek"/>
                            <TextBlock x:Name="LastEn" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" Text="–"/>
                            <TextBlock x:Name="LastCs" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" Text="–"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,2,0,12">
                        <Button x:Name="BtnOverlayVis" Content="👁  Skrýt / zobrazit overlay (F9)" Click="OnToggleOverlay"/>
                        <Button Content="✨  Ukázka v overlayi" Click="OnOverlaySample"/>
                    </WrapPanel>

                    <Expander Header="Technické podrobnosti" Margin="0,6,0,0" Foreground="{StaticResource Muted}">
                        <StackPanel Margin="0,10,0,0">
                    <UniformGrid Columns="4" Margin="0,0,0,2">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,12"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="CPU aplikace"/><TextBlock x:Name="TileCpu" Style="{StaticResource TileValue}" Text="–"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,12"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="Čas OCR"/><TextBlock x:Name="TileOcr" Style="{StaticResource TileValue}" Text="–"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,12"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="Čas překladu"/><TextBlock x:Name="TileTr" Style="{StaticResource TileValue}" Text="–"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="FPS zdroje"/><TextBlock x:Name="TileFps" Style="{StaticResource TileValue}" Text="–"/></StackPanel></Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Podrobnosti"/>
                            <TextBox x:Name="DashText" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,6,0,0" Padding="0"/>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel></ScrollViewer>
            </TabItem>

<TabItem x:Name="TabTranslation" Header="🌐  Překlad">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Překlad"/>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Jazyk titulků ve hře (čtení OCR) → jazyk překladu:"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <ComboBox x:Name="CbSrcLang" Width="250" DisplayMemberPath="Name"/>
                                <TextBlock Text="  →  " VerticalAlignment="Center" FontSize="16"/>
                                <ComboBox x:Name="CbTgtLang" Width="250" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Změna jazyka titulků (OCR) se projeví po restartu aplikace a vyžaduje nainstalovaný jazykový balíček Windows OCR. DeepL nepodporuje všechny jazyky (hindština, hebrejština, thajština, vietnamština) – použijte Google."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Překladač (žádné automatické přepínání – když selže, uvidíte chybu):"/>
                            <ComboBox x:Name="CbTranslator" Margin="0,4,0,8" Width="420" HorizontalAlignment="Left" SelectionChanged="OnTranslatorChanged"/>
                            <Border x:Name="GoogleWarn" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock Foreground="{StaticResource Warn}" TextWrapping="Wrap" Text="Google Translate bez klíče používá NEOFICIÁLNÍ veřejný endpoint (translate.googleapis.com, client=gtx). Není to oficiální API, nemá záruku funkčnosti a Google ho může kdykoli omezit nebo změnit. Pro spolehlivý provoz zvažte oficiální Google Cloud API nebo DeepL s klíčem."/>
                            </Border>
                            <StackPanel x:Name="PnlGoogleCloud">
                                <TextBlock FontWeight="SemiBold" Text="Google Cloud Translation – API klíč" Margin="0,6,0,2"/>
                                <DockPanel><Button DockPanel.Dock="Right" Content="Smazat uložený" Margin="8,0,0,0" Click="OnClearGoogleKey"/><PasswordBox x:Name="PbGoogle" Padding="3"/></DockPanel>
                                <TextBlock x:Name="GoogleKeyState" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <StackPanel x:Name="PnlDeepL">
                                <TextBlock FontWeight="SemiBold" Text="DeepL – API klíč (Free končí na :fx → api-free.deepl.com, jinak api.deepl.com)" Margin="0,6,0,2"/>
                                <DockPanel><Button DockPanel.Dock="Right" Content="Smazat uložený" Margin="8,0,0,0" Click="OnClearDeepLKey"/><PasswordBox x:Name="PbDeepL" Padding="3"/></DockPanel>
                                <TextBlock x:Name="DeepLKeyState" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <StackPanel x:Name="PnlGemini">
                                <TextBlock FontWeight="SemiBold" Text="Gemini – API klíč a model" Margin="0,6,0,2"/>
                                <DockPanel><Button DockPanel.Dock="Right" Content="Smazat uložený" Margin="8,0,0,0" Click="OnClearGeminiKey"/><PasswordBox x:Name="PbGemini" Padding="3"/></DockPanel>
                                <TextBlock x:Name="GeminiKeyState" Style="{StaticResource Hint}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Style="{StaticResource Lbl}" Text="Model:"/><TextBox x:Name="TbGeminiModel" Width="240"/></StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="PnlAi">
                                <TextBlock FontWeight="SemiBold" Text="AI přes OpenAI-kompatibilní server (Ollama, LM Studio, OpenAI, OpenRouter…)" Margin="0,6,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Adresa (…/v1):"/><TextBox x:Name="TbAiUrl" Grid.Column="1" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Model:"/><TextBox x:Name="TbAiModel" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="API klíč (volitelný):"/><PasswordBox x:Name="PbAi" Grid.Row="2" Grid.Column="1" Margin="0,3" Padding="3"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1. Místní model nic neposílá na internet. Rychlost a kvalita závisí na modelu; AI překlad bývá pomalejší než Google, proto zkuste menší model."/>
                                <TextBlock x:Name="AiKeyState" Style="{StaticResource Hint}"/>
                                <TextBlock FontWeight="SemiBold" Margin="0,8,0,2" Text="Kontext hry pro AI (volitelné, např. „kriminální příběh, hovorová řeč, vulgarismy“):"/>
                                <TextBox x:Name="TbAiContext" TextWrapping="Wrap"/>
                                <TextBlock Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0" Text="Pozor: u Gemini a placených AI se text titulků posílá poskytovateli. Používání může být zpoplatněno."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Klíče se ukládají šifrovaně přes Windows DPAPI (vázáno na váš účet), do logů se nikdy nezapisují."/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Test spojení (vybraný překladač)" Click="OnTestTranslator"/>
                                <Button Content="Smazat cache překladů" Click="OnClearCache"/>
                            </WrapPanel>
                            <TextBox x:Name="TranslatorTestResult" IsReadOnly="True" TextWrapping="Wrap" MinHeight="46" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Slovník jmen a frází (jeden na řádek):"/>
                            <TextBox x:Name="TbGlossary" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                            <TextBlock Style="{StaticResource Hint}" Text="„Vice City“ = nepřekládat. „jackpot = výhra“ = vždy přeložit takto. Řádky začínající # jsou poznámky."/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AdvTranslation" Style="{StaticResource AdvPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AdvTag}" Text="POKROČILÉ"/>
                            <CheckBox x:Name="CbContext" Content="Posílat předchozí titulky jako kontext (využije DeepL; Google ho ignoruje)"/>
                            <CheckBox x:Name="CbSpeculative" Content="Překládat hned po prvním přečtení (rychlejší zobrazení; může spotřebovat víc znaků z limitu překladače)"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Style="{StaticResource Lbl}" Text="Počet předchozích vět kontextu (0–6):"/><TextBox x:Name="TbCtxLines" Width="60"/></StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabItem>

<TabItem x:Name="TabSpeech" Header="🔊  Hlas">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Čtení překladu nahlas"/>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="Přeložené titulky se přečtou nahlas hlasem nainstalovaným ve Windows. Je zdarma, funguje offline a nepotřebuje žádný účet ani klíč. Zvuk jde na výchozí výstup Windows."/>
                            <CheckBox x:Name="CbSpeech" Content="Číst překlady nahlas"/>
                            <StackPanel x:Name="PnlWindows" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Hint}" Text="Nic se neposílá na internet. Když není vybrán žádný hlas, použije se první hlas v jazyce překladu."/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Hlas Windows:"/>
                                    <ComboBox x:Name="CbWinVoice" Grid.Column="1" Margin="0,3"/>
                                </Grid>
                                <TextBlock x:Name="WinVoiceInfo" Style="{StaticResource Hint}" Margin="0,2,0,4"/>
                                <Button Content="Otevřít nastavení řeči Windows (přidat hlasy)" HorizontalAlignment="Left" Click="OnOpenWinSpeechSettings"/>
                            </StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Hlasitost hlasu" Margin="0,14,0,2"/>
                            <DockPanel>
                                <TextBlock x:Name="TxtSpeechVolume" DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider x:Name="SlSpeechVolume" Minimum="0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.25" TickPlacement="BottomRight" ValueChanged="OnSpeechVolumeChanged"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8" Text="Mění se hned za chodu, restart není potřeba. Hlasitost lze měnit i zkratkami (záložka Zkratky). Nad 100 % se zvuk zesiluje a může zkreslit; hlasitost vůči hře si nastavte i v mixéru hlasitosti Windows."/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Test hlasu" Click="OnTestSpeech"/>
                                <Button Content="Přehrát ukázku" Click="OnSpeechSample"/>
                            </WrapPanel>
                            <TextBox x:Name="SpeechTestResult" IsReadOnly="True" TextWrapping="Wrap" MinHeight="46" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AdvSpeech" Style="{StaticResource AdvPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AdvTag}" Text="POKROČILÉ"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Rychlost řeči (0,5–2):"/>
                                <TextBox x:Name="TbSpeechRate" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Max. vět čekajících ve frontě (1–5):"/>
                                <TextBox x:Name="TbSpeechQueue" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="Titulky ve hrách jsou krátké a rychlé. Když hlas nestíhá, starší věty se přeskočí a další se řeknou o něco rychleji, aby se neopozdil celý dialog. Hlas se čte jen v režimu konverzace."/>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabItem>

<TabItem x:Name="TabOverlay" Header="🖼  Vzhled">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Vzhled překladu"/>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Velikost písma (10–120):"/>
                                <TextBox x:Name="TbFontSize" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Průhlednost pozadí (neprůhlednost):"/>
                                <Slider x:Name="SlOpacity" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,6"/>
                            </Grid>
                            <CheckBox x:Name="CbCover" Content="Zakrýt původní titulky: překlad se zobrazí PŘÍMO PŘES originál na neprůhledném černém pozadí (originál není vidět). Vypnuto = překlad je nad originálem a originál zůstane vidět." Margin="0,10,0,0"/>
                            <CheckBox x:Name="CbShowEn" Content="Zobrazit anglický originál nad českým překladem" Margin="0,8,0,0"/>
                            <CheckBox x:Name="CbAutoAbove" Content="Umístit overlay automaticky NAD původní titulky (vypne se ručním přesunem)" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Poloha překladu"/>
                            <WrapPanel>
                                <Button x:Name="BtnEditOverlay" Content="Upravit polohu a velikost overlaye myší" Click="OnEditOverlay"/>
                                <Button Content="Umístit myší (nakreslit obdélník)" Click="OnPlaceOverlayByMouse"/>
                                <Button Content="Výchozí umístění (nad titulky)" Click="OnOverlayDefaultPlace"/>
                                <Button Style="{StaticResource AccentButton}" Content="Zobrazit ukázku" Click="OnOverlaySample"/>
                            </WrapPanel>
                            <TextBlock x:Name="OverlayInfo" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AdvOverlay" Style="{StaticResource AdvPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AdvTag}" Text="POKROČILÉ"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Písmo:"/>
                                <TextBox x:Name="TbFont" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Barva českého textu (#RRGGBB):"/>
                                <TextBox x:Name="TbColor" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Barva anglického textu:"/>
                                <TextBox x:Name="TbEnColor" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Max. počet zobrazených titulků (1–8):"/>
                                <TextBox x:Name="TbMaxLines" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="4" Style="{StaticResource Lbl}" Text="Doba zobrazení (s; 0 = automaticky):"/>
                                <TextBox x:Name="TbSeconds" Grid.Row="4" Grid.Column="1" Margin="0,3"/>
                            </Grid>
                            <CheckBox x:Name="CbClickThrough" Content="Click-through (klik prochází skrz overlay do hry)" Margin="0,8,0,0"/>
                            <CheckBox x:Name="CbExclude" Content="Skrýt overlay před záchytem obrazovky (zapnuto = v OBS ho NEUVIDÍTE; vypněte, pokud ho chcete streamovat)"/>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem x:Name="TabSettings" Header="⚙  Nastavení">
                <TabControl x:Name="SettingsTabs" Style="{StaticResource TopTabsControl}">
                    <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource TopTabItem}"/></TabControl.Resources>

    <TabItem x:Name="TabSetup" Header="Obecné">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="Obecné"/>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Jazyk rozhraní"/>
                                <ComboBox x:Name="CbUiLang" Margin="0,4" Width="320" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectionChanged="OnUiLangChanged"/>
                                <TextBlock x:Name="UiLangNote" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Další jazyky stačí přidat jako soubor do složky Languages (viz Languages/README.md). Opravy překladů jsou vítané."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Spouštění"/>
                                <CheckBox x:Name="CbAutostart" Content="Spouštět Overlingo s Windows (minimalizované)" Margin="0,4"/>
                                <CheckBox x:Name="CbStartTranslate" Content="Po spuštění aplikace rovnou spustit překlad"/>
                                <CheckBox x:Name="CbAutoProgram" Content="Spustit překlad automaticky, když se objeví vybraný program (zdroj „Program“)"/>
                                <CheckBox x:Name="CbGameProfiles" Content="Pamatovat oblast titulků, vzhled a výkon zvlášť pro každou hru (zdroj „Program“)" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Úvodní nastavení"/>
                                <ContentControl x:Name="SetupHost"/>
                                <Button Content="Spustit průvodce nastavením" Click="OnRunWizard" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel></ScrollViewer>
                </TabItem>

    <TabItem x:Name="TabHotkeys" Header="Zkratky">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="Zkratky"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Klikněte do políčka a stiskněte novou kombinaci kláves (např. F8 nebo Ctrl+Shift+T). Backspace = vrátit výchozí. Použije se po „Uložit a použít“. Zkratky jsou globální (fungují i uvnitř hry)."/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Lbl}" Text="Zapnout / vypnout překlad:"/>
                            <TextBox x:Name="HkToggle" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="F8" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Zobrazit / skrýt overlay:"/>
                            <TextBox x:Name="HkOverlay" Grid.Row="1" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="F9" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Pauza / obnovení OCR:"/>
                            <TextBox x:Name="HkPause" Grid.Row="2" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="F10" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Vybrat oblast titulků:"/>
                            <TextBox x:Name="HkRegion" Grid.Row="3" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="F11" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="4" Style="{StaticResource Lbl}" Text="Otevřít okno nastavení:"/>
                            <TextBox x:Name="HkSettings" Grid.Row="4" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="F12" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="5" Style="{StaticResource Lbl}" Text="Přepnout: konverzace ↔ vše na obrazovce:"/>
                            <TextBox x:Name="HkScope" Grid.Row="5" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="F7" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="6" Style="{StaticResource Lbl}" Text="Okno historie titulků:"/>
                            <TextBox x:Name="HkHistory" Grid.Row="6" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="F6" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="7" Style="{StaticResource Lbl}" Text="Špatný překlad (opravit poslední):"/>
                            <TextBox x:Name="HkCorrect" Grid.Row="7" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="F5" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="8" Style="{StaticResource Lbl}" Text="Hlas zap / vyp:"/>
                            <TextBox x:Name="HkSpeech" Grid.Row="8" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="F4" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="9" Style="{StaticResource Lbl}" Text="Hlasitost hlasu +:"/>
                            <TextBox x:Name="HkVolUp" Grid.Row="9" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="Ctrl+PageUp" PreviewKeyDown="OnHotkeyKey"/>
                            <TextBlock Grid.Row="10" Style="{StaticResource Lbl}" Text="Hlasitost hlasu −:"/>
                            <TextBox x:Name="HkVolDown" Grid.Row="10" Grid.Column="1" Margin="0,3" IsReadOnly="True" Tag="Ctrl+PageDown" PreviewKeyDown="OnHotkeyKey"/>
                        </Grid>
                        <TextBlock x:Name="HotkeyInfo" Margin="0,10" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
    <TabItem x:Name="TabOcr" Header="OCR">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="OCR"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Lbl}" Text="Interval čtení (ms):" Margin="0,4"/>
                            <TextBox x:Name="TbInterval" Grid.Column="1" Margin="0,3"/>
                            <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="100–3000, doporučeno 250–500"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Režim OCR:"/>
                            <ComboBox x:Name="CbOcrMode" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="Auto = izolace bílého textu, při slabém výsledku porovná s originálem"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Práh světlosti textu (60–250):"/>
                            <TextBox x:Name="TbThreshold" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="Citlivost: nižší = chytá i šedší text (víc šumu)"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Zvětšení před OCR (1–3×):"/>
                            <TextBox x:Name="TbUpscale" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                            <TextBlock Grid.Row="4" Style="{StaticResource Lbl}" Text="Shodná čtení před zobrazením (1–5):"/>
                            <TextBox x:Name="TbStable" Grid.Row="4" Grid.Column="1" Margin="0,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="Vyšší = méně chybných zobrazení, ale pomalejší reakce"/>
                            <TextBlock Grid.Row="5" Style="{StaticResource Lbl}" Text="Práh změny obrazu (0,002–0,2):"/>
                            <TextBox x:Name="TbChange" Grid.Row="5" Grid.Column="1" Margin="0,3"/>
                            <TextBlock Grid.Row="6" Style="{StaticResource Lbl}" Text="Min. počet písmen titulku:"/>
                            <TextBox x:Name="TbMinLetters" Grid.Row="6" Grid.Column="1" Margin="0,3"/>
                        </Grid>
                        <CheckBox x:Name="CbSkipNoText" Content="Přeskočit OCR, když v oblasti není žádný světlý text (šetří CPU)" Margin="0,8,0,0"/>
                        <CheckBox x:Name="CbTesseract" Content="Pomocný druhý OCR engine Tesseract při slabém čtení (jen když je nainstalovaný)" Margin="0,4,0,0"/>
                        <DockPanel Margin="26,4,0,0"><TextBlock Style="{StaticResource Lbl}" Text="Cesta k tesseract.exe (prázdné = automaticky):"/><TextBox x:Name="TbTessPath"/></DockPanel>
                        <TextBlock x:Name="TessInfo" Foreground="{StaticResource Muted}" Margin="26,4,0,0" TextWrapping="Wrap"/>
                        <Separator Margin="0,10"/>
                        <WrapPanel>
                            <Button Content="Test OCR teď (aktuální oblast)" Click="OnOcrNow"/>
                        </WrapPanel>
                        <TextBlock x:Name="OcrEngineInfo" Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <Image x:Name="OcrPreview" MaxHeight="140" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,4"/>
                        <TextBox x:Name="OcrResult" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" FontSize="14"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
    <TabItem x:Name="TabAdvanced" Header="Pokročilé">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="Pokročilé"/>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <CheckBox x:Name="CbAdaptive" Content="Adaptivní interval – při dlouhém klidu (žádný titulek) zpomalit čtení a šetřit CPU"/>
                                <CheckBox x:Name="CbVerbose" Content="Podrobný log (každé čtení OCR, rozhodnutí o duplicitách, prodleva do zobrazení) – užitečné při ladění"/>
                                <CheckBox x:Name="CbStripJunk" Content="Odstraňovat typické OCR smetí (samostatné symboly, „oo:c“ apod.) před překladem"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Lbl}" Text="Velikost cache překladů (vět):"/>
                                    <TextBox x:Name="TbCacheMax" Grid.Column="1" Margin="0,3"/>
                                    <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="použije se po restartu aplikace"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Časový limit požadavku na překlad (s):"/>
                                    <TextBox x:Name="TbHttpTimeout" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Opakování po síťové chybě / chybě serveru (0–3):"/>
                                    <TextBox x:Name="TbRetry" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="chyba klíče / limitu se neopakuje; překladač se nikdy nepřepíná sám"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Vše na obrazovce: velikost písma (× výšky řádku):"/>
                                    <TextBox x:Name="TbScreenScale" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Style="{StaticResource Lbl}" Text="Vše na obrazovce: min. interval OCR (ms):"/>
                                    <TextBox x:Name="TbScreenInterval" Grid.Row="4" Grid.Column="1" Margin="0,3"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Style="{StaticResource Lbl}" Text="Max. délka titulku (znaků, 0 = bez limitu):"/><TextBox x:Name="TbMaxChars" Width="70"/></StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Delší čtení a texty plné čísel (panely s FPS, statistikami) se berou jako UI, ne titulek, a nepřekládají se."/>
                                <TextBlock FontWeight="SemiBold" Margin="0,12,0,2" Text="Ignorovat řádky obsahující (oddělte středníkem), např. Unknown; Call; Snapmatic:"/>
                                <TextBox x:Name="TbIgnore" Margin="0,2"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Hodí se pro UI texty, které nechcete překládat (telefon, hodiny, názvy menu). Platí pro oba režimy."/>
                                <Button x:Name="BtnResetTuning" Content="Obnovit doporučené hodnoty výkonu a OCR" Click="OnResetTuning" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="OBS Browser Source (překlad do streamu bez zachytávání obrazovky)"/>
                                <CheckBox x:Name="CbWeb" Content="Zapnout lokální server (jen tento počítač, 127.0.0.1)" Margin="0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Style="{StaticResource Lbl}" Text="Port:"/><TextBox x:Name="TbWebPort" Width="80"/>
                                    <Button Content="Kopírovat adresu" Margin="8,0,0,0" Click="OnCopyWebUrl"/></StackPanel>
                                <TextBlock x:Name="WebUrlText" Style="{StaticResource Hint}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="V OBS: Zdroje → + → Prohlížeč, vložte adresu, šířka 1920 a výška 1080. Styl lze měnit parametry, např. ?size=44&amp;color=ffff00&amp;english=1"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Profily nastavení"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <ComboBox x:Name="CbProfile" IsEditable="True" Width="240"/>
                                    <Button Content="Uložit" Margin="8,0,0,0" Click="OnProfileSave"/>
                                    <Button Content="Načíst" Click="OnProfileLoad"/>
                                    <Button Content="Smazat" Click="OnProfileDelete"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Profil uloží vše kromě API klíčů – např. jiné nastavení pro hru a pro film."/>
                            </StackPanel>
                        </Border>
                    </StackPanel></ScrollViewer>
                </TabItem>

    <TabItem x:Name="TabDiag" Header="Řešení problémů">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="Řešení problémů"/>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Něco nefunguje? Vytvořte diagnostiku (zip bez API klíčů) a přiložte ji k hlášení chyby na GitHubu."/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Exportovat diagnostiku (zip)" Click="OnExportZip"/>
                                    <Button Content="Historie titulků" Click="OnShowHistory"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Expander Header="Diagnostika" Margin="0,4,0,0">
                            <StackPanel Margin="0,8,0,8">
                                <WrapPanel>
                                    <Button x:Name="BtnDiag" Content="Spustit diagnostiku" Click="OnRunDiagnostics" FontWeight="SemiBold"/>
                                    <Button Content="Uložit report do souboru" Click="OnSaveDiagnostics"/>
                                </WrapPanel>
                                <TextBox x:Name="DiagBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Logy" Margin="0,4,0,0">
                            <StackPanel Margin="0,8,0,8">
                                <WrapPanel>
                                    <Button Content="Vymazat okno logu" Click="OnClearLog"/>
                                    <Button Content="Otevřít složku s logy" Click="OnOpenLogDir"/>
                                    <CheckBox x:Name="CbLogFile" Content="Zapisovat log do souboru" IsChecked="True" Margin="10,5,0,0" Click="OnLogFileToggle"/>
                                </WrapPanel>
                                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Test" Margin="0,4,0,0">
                            <StackPanel Margin="0,8,0,8">
                                <TextBlock TextWrapping="Wrap" Text="Měření přesnosti OCR na přibalených testovacích obrázcích a ruční test překladu." Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="Přesnost OCR na přibalených testovacích obrázcích" Click="OnOcrAccuracy"/>
                                </WrapPanel>
                                <TextBlock FontWeight="SemiBold" Text="Ruční test překladu (vybraný překladač):"/>
                                <TextBox x:Name="TbManual" Text="Hey, keep your voice down. They're still watching the street." Margin="0,4" TextWrapping="Wrap"/>
                                <Button Content="Přeložit" Click="OnManualTranslate" HorizontalAlignment="Left"/>
                                <TextBox x:Name="ManualResult" IsReadOnly="True" TextWrapping="Wrap" MinHeight="46"/>
                                <TextBox x:Name="TestLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MinHeight="200" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel></ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabAbout" Header="O programu">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,26" MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Padding="28">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="96" Height="96" CornerRadius="22" Margin="0,0,24,0">
                                    <Border.Effect><DropShadowEffect Color="#FF3A63E0" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                                    <Image Source="Assets/overlingo-1024.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="30" FontWeight="Black" Foreground="{StaticResource Accent}" Text="Overlingo"/>
                                    <TextBlock Foreground="{StaticResource Muted}" Text="Live screen translator – překlad titulků v reálném čase"/>
                                    <TextBlock x:Name="AboutVersion" Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AboutRuntime" Foreground="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock TextWrapping="Wrap" Margin="2,6,2,12" Text="Overlingo čte titulky z obrazovky nebo záznamové karty, překládá je a zobrazuje nad hrou v průhledném overlayi. Je zdarma a otevřený (licence MIT). Přeloženým titulkům se nic nezamyká ani nehlídá – tvůrce ho dělá ve volném čase."/>
                        <WrapPanel>
                            <Button Content="GitHub projektu" Tag="https://github.com/SkilineFPS/Overlingo" Click="OnOpenUrl"/>
                            <Button Content="Nahlásit chybu / nápad" Tag="https://github.com/SkilineFPS/Overlingo/issues" Click="OnOpenUrl"/>
                            <Button Content="Stáhnout nejnovější verzi" Tag="https://github.com/SkilineFPS/Overlingo/releases/latest" Click="OnOpenUrl"/>
                            <Button Content="❤  Podpořit autora" Style="{StaticResource SupportButton}" Click="OnSupport" Padding="16,9"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource H2}" Margin="0,18,0,4" Text="Licence a použité komponenty"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Overlingo je vydáno pod licencí MIT. Seznam použitých komponent je v souboru THIRD-PARTY-NOTICES.md u programu. Překlady provádí vámi zvolená služba (např. Google, DeepL) – s jejich podmínkami se seznamte sami. Program není právní ani jiná odborná rada."/>
                        <Button Content="Zkopírovat informace o verzi (pro hlášení chyb)" Click="OnCopyVersionInfo" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
                </TabControl>
            </TabItem>
            </TabControl>
            <!-- logo v levém sloupci -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="240" Margin="0,22,0,0" Orientation="Horizontal" IsHitTestVisible="False">
                <Border Width="52" Height="52" CornerRadius="13" Margin="20,0,12,0">
                    <Border.Effect><DropShadowEffect Color="#FF3A63E0" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                    <Image Source="Assets/overlingo-1024.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="21" FontWeight="Black" Foreground="White" Text="OVERLINGO"/>
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Amber}" Text="LIVE SCREEN TRANSLATOR"/>
                </StackPanel>
            </StackPanel>
            <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="208" Margin="16,0,0,44" Padding="10,10" Style="{StaticResource SupportButton}" Content="❤  Podpořit autora" Click="OnSupport" ToolTip="Dobrovolná podpora přes PayPal. Overlingo je zdarma a nic se kvůli tomu nezamyká."/>
            <TextBlock x:Name="NavVersion" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,16" FontSize="11" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</Window>
